@page
@model TravelBlog.Web.Areas.Identity.Pages.Account.Manage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator app";
}

<div class="mb-4">
    <h2 class="h3 mb-2">Authenticator app</h2>
    <p class="text-muted mb-0">
        Enter this key in your authenticator app, then confirm a code from it.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">
        @Model.StatusMessage
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Key</dt>
    <dd class="col-sm-9">
        <code class="user-select-all">@Model.SharedKey</code>
    </dd>
</dl>

<p class="text-muted">
    Spaces and capitalization do not matter. After the app is added,
    enter the current 6-digit code below.
</p>

<form method="post">
    <div
        asp-validation-summary="ModelOnly"
        class="text-danger mb-3">
    </div>

    <div class="mb-4">
        <label
            asp-for="Input.Code"
            class="form-label">
        </label>
        <input
            asp-for="Input.Code"
            class="form-control"
            autocomplete="one-time-code"
            inputmode="numeric" />
        <span
            asp-validation-for="Input.Code"
            class="text-danger">
        </span>
    </div>

    <button
        type="submit"
        class="btn btn-primary">
        Verify
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
