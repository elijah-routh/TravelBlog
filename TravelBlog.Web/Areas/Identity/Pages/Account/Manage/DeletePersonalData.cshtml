@page
@model TravelBlog.Web.Areas.Identity.Pages.Account.Manage.DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete personal data";
}

<div class="mb-4">
    <h2 class="h3 mb-2">Delete personal data</h2>
    <p class="text-muted mb-0">
        This permanently closes your account. It cannot be undone.
    </p>
</div>

<div class="alert alert-danger">
    Your posts, comments, and club writing stay on the site and are
    attributed to a deleted user. Club memberships and votes are removed.
</div>

<form method="post">
    <div
        asp-validation-summary="ModelOnly"
        class="text-danger mb-3">
    </div>

    <div class="mb-4">
        <label
            asp-for="Input.Password"
            class="form-label">
        </label>
        <input
            asp-for="Input.Password"
            class="form-control"
            autocomplete="current-password" />
        <span
            asp-validation-for="Input.Password"
            class="text-danger">
        </span>
    </div>

    <button
        type="submit"
        class="btn btn-danger">
        Delete data and close my account
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
