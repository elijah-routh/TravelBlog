@page
@model TravelBlog.Web.Areas.Identity.Pages.Account.Manage.ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
}

<div class="mb-4">
    <h2 class="h3 mb-2">Recovery codes</h2>
    <p class="text-muted mb-0">
        Copy these codes now. They will not be shown again.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">
        @Model.StatusMessage
    </div>
}

<div class="alert alert-warning">
    If you lose your authenticator app and these codes, you will not be able
    to sign in.
</div>

<ul class="list-unstyled mb-4">
    @foreach (var code in Model.RecoveryCodes ?? [])
    {
        <li class="mb-2">
            <code class="user-select-all">@code</code>
        </li>
    }
</ul>

<a asp-page="./TwoFactorAuthentication" class="btn btn-primary">
    Back to two-factor authentication
</a>
