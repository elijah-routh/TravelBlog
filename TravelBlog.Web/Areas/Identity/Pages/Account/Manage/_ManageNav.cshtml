@{
    var currentPage =
        ViewContext.RouteData.Values["page"]?.ToString();

    string ActiveClass(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    var navItems = new[]
    {
        new
        {
            Page = "/Account/Manage/Index",
            Route = "./Index",
            Label = "Profile",
            ShortLabel = "Profile"
        },
        new
        {
            Page = "/Account/Manage/Email",
            Route = "./Email",
            Label = "Email",
            ShortLabel = "Email"
        },
        new
        {
            Page = "/Account/Manage/ChangePassword",
            Route = "./ChangePassword",
            Label = "Password",
            ShortLabel = "Password"
        },
        new
        {
            Page = "/Account/Manage/TwoFactorAuthentication",
            Route = "./TwoFactorAuthentication",
            Label = "Two-factor authentication",
            ShortLabel = "2FA"
        },
        new
        {
            Page = "/Account/Manage/PersonalData",
            Route = "./PersonalData",
            Label = "Personal data",
            ShortLabel = "Data"
        }
    };
}

<nav
    class="account-manage-nav account-manage-nav--desktop nav flex-column gap-2 d-none d-lg-flex"
    aria-label="Account settings">
    @foreach (var item in navItems)
    {
        <a
            class="nav-link @ActiveClass(item.Page)"
            asp-page="@item.Route">
            <span class="account-nav-label">@item.Label</span>
            <span aria-hidden="true">›</span>
        </a>
    }

    <form
        class="account-manage-logout"
        asp-area="Identity"
        asp-page="/Account/Logout"
        asp-route-returnUrl="@Url.Content("~/")"
        method="post">
        <button
            type="submit"
            class="nav-link account-logout-button w-100">
            <span class="account-nav-label">Logout</span>
            <span aria-hidden="true">→</span>
        </button>
    </form>
</nav>

<div class="account-manage-nav-mobile d-lg-none">
    <nav
        class="account-manage-nav account-manage-nav--mobile"
        aria-label="Account settings">
        <div class="account-manage-nav__scroll">
            @foreach (var item in navItems)
            {
                <a
                    class="account-manage-pill @ActiveClass(item.Page)"
                    asp-page="@item.Route">
                    @item.ShortLabel
                </a>
            }

            <form
                class="account-manage-logout-inline"
                asp-area="Identity"
                asp-page="/Account/Logout"
                asp-route-returnUrl="@Url.Content("~/")"
                method="post">
                <button
                    type="submit"
                    class="account-manage-logout-link">
                    Log out
                </button>
            </form>
        </div>
    </nav>
</div>
