@page
@model TravelBlog.Web.Areas.Identity.Pages.Account.Manage.EmailModel
@{
    ViewData["Title"] = "Email";
}

<div class="mb-4">
    <h2 class="h3 mb-2">Email</h2>
    <p class="text-muted mb-0">
        Review the address and verification status for your account.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsVerified)
        {
            <span class="badge bg-success">Verified</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Not verified</span>
        }
    </dd>
</dl>

@if (!Model.IsVerified)
{
    <div class="alert alert-warning">
        Verify your email before creating or changing site content.
    </div>
    <form method="post" asp-page-handler="SendVerification">
        <button type="submit" class="btn btn-primary">
            Resend verification email
        </button>
    </form>
}
