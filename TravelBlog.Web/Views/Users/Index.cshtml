@model IReadOnlyCollection<UserAdministrationViewModel>
@{
    ViewData["Title"] = "Users";
}
<section class="content-section"><div class="container">
    <partial name="_AdminNav" />
    <h1>Users</h1>
    <p class="text-muted">Manage administrator access.</p>
    @if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th class="text-end">Action</th></tr></thead>
        <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td>
                    @account.DisplayName
                    @if (account.IsLockedOut)
                    {
                        if (account.CanUnlock)
                        {
                            <form
                                asp-action="Unlock"
                                asp-route-id="@account.Id"
                                method="post"
                                class="d-inline">
                                <button
                                    type="submit"
                                    class="btn btn-link link-danger p-0 align-baseline"
                                    aria-label="Unlock @account.DisplayName's account"
                                    title="Unlock account">
                                    <svg
                                        aria-hidden="true"
                                        focusable="false"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 16 16"
                                        fill="currentColor">
                                        <path d="M5.5 6V4.5a2.5 2.5 0 0 1 5 0h1a3.5 3.5 0 0 0-7 0V6H3.75A1.75 1.75 0 0 0 2 7.75v5.5C2 14.22 2.78 15 3.75 15h8.5c.97 0 1.75-.78 1.75-1.75v-5.5C14 6.78 13.22 6 12.25 6H5.5Z" />
                                    </svg>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span
                                class="text-danger"
                                role="img"
                                aria-label="Account locked"
                                title="Account locked">
                                <svg
                                    aria-hidden="true"
                                    focusable="false"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 16 16"
                                    fill="currentColor">
                                    <path d="M5.5 6V4.5a2.5 2.5 0 0 1 5 0h1a3.5 3.5 0 0 0-7 0V6H3.75A1.75 1.75 0 0 0 2 7.75v5.5C2 14.22 2.78 15 3.75 15h8.5c.97 0 1.75-.78 1.75-1.75v-5.5C14 6.78 13.22 6 12.25 6H5.5Z" />
                                </svg>
                            </span>
                        }
                    }
                </td>
                <td>@account.Email</td>
                <td>
                    @(account.IsBootstrapAdmin
                        ? "Admin (star)"
                        : account.IsAdmin ? "Admin" : "Author")
                    @if (!account.IsVerified)
                    {
                        <span class="badge bg-warning text-dark">Unverified</span>
                    }
                    @if (account.IsBlocked)
                    {
                        <span class="badge bg-danger">Blocked</span>
                    }
                </td>
                <td class="text-end">
                    @if (account.CanBlock)
                    {
                        if (account.IsBlocked)
                        {
                            <form asp-action="Unblock" asp-route-id="@account.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Unblock</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Block" asp-route-id="@account.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Block</button>
                            </form>
                        }
                    }
                    @if (account.IsAdmin && !account.IsBootstrapAdmin)
                    {
                        <form asp-action="Demote" asp-route-id="@account.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Demote</button>
                        </form>
                    }
                    else if (!account.IsAdmin && account.IsVerified)
                    {
                        <form asp-action="Promote" asp-route-id="@account.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Promote to Admin</button>
                        </form>
                    }
                    else if (!account.IsVerified)
                    {
                        <span class="text-muted">Verification required</span>
                    }
                    @if (account.CanRemove)
                    {
                        <a
                            asp-action="Remove"
                            asp-route-id="@account.Id"
                            class="btn btn-sm btn-outline-danger rounded-circle account-remove-button ms-1"
                            aria-label="Remove @account.DisplayName's account"
                            title="Remove account">
                            <span aria-hidden="true">&times;</span>
                        </a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
</div></section>
