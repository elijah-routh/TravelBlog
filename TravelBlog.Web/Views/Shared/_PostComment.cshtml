@model PostCommentItemViewModel

<p class="fw-semibold mb-1">@Model.AuthorDisplayName</p>
<p class="club-discussion-body mb-1">@Model.Body</p>
<p class="small text-muted mb-2">
    @Model.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
    @if (Model.UpdatedAt is not null)
    {
        <text>· edited</text>
    }
</p>

<div class="comment-actions mb-2">
    @{
        var commentLikeButton = new LikeButtonViewModel
        {
            Count = Model.LikeCount,
            IsLiked = Model.IsLikedByCurrentUser,
            CanLike = Model.CanLike,
            Controller = "Posts",
            Action = "ToggleCommentLike",
            RouteValues = new Dictionary<string, string>
            {
                ["id"] = Model.Id.ToString()
            }
        };
    }
    <partial name="_LikeButton" model="commentLikeButton" />
    @if (Model.CanEdit)
    {
        <a
            asp-controller="Posts"
            asp-action="EditComment"
            asp-route-id="@Model.Id"
            class="icon-action"
            title="Edit comment"
            aria-label="Edit comment">
            &#9998;
        </a>
    }
    @if (Model.CanDelete)
    {
        <a
            asp-controller="Posts"
            asp-action="DeleteComment"
            asp-route-id="@Model.Id"
            class="icon-action icon-action-danger"
            title="Delete comment"
            aria-label="Delete comment">
            &#128465;
        </a>
    }
    @if (Model.CanReply)
    {
        <button
            type="button"
            class="reply-toggle"
            data-bs-toggle="collapse"
            data-bs-target="#comment-reply-@Model.Id"
            aria-expanded="false"
            aria-controls="comment-reply-@Model.Id">
            Reply
        </button>
    }
</div>

@if (Model.CanReply)
{
    <div class="collapse" id="comment-reply-@Model.Id">
        <form
            asp-controller="Posts"
            asp-action="ReplyComment"
            asp-route-id="@Model.Id"
            method="post"
            class="compact-reply-form mb-3">
            <label class="visually-hidden" for="comment-reply-body-@Model.Id">
                Reply
            </label>
            <textarea
                name="Body"
                id="comment-reply-body-@Model.Id"
                class="form-control form-control-sm mb-2"
                rows="2"
                maxlength="2000"
                placeholder="Write a reply."
                required></textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary">
                Post Reply
            </button>
        </form>
    </div>
}

@if (Model.Replies.Count > 0)
{
    <button
        type="button"
        class="reply-toggle"
        data-bs-toggle="collapse"
        data-bs-target="#comment-thread-@Model.Id"
        aria-expanded="false"
        aria-controls="comment-thread-@Model.Id">
        @Model.Replies.Count @(Model.Replies.Count == 1 ? "reply" : "replies")
    </button>
    <div class="collapse" id="comment-thread-@Model.Id">
        <ul class="list-unstyled club-discussion-replies">
            @foreach (var reply in Model.Replies)
            {
                <li class="club-discussion-post club-discussion-reply">
                    <partial name="_PostComment" model="reply" />
                </li>
            }
        </ul>
    </div>
}
