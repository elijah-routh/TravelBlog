@using TravelBlog.Web.Authorization
@{
    var pageTitle = ViewData["Title"] as string;
    var documentTitle =
        string.IsNullOrWhiteSpace(pageTitle) ||
        string.Equals(pageTitle, "Home", StringComparison.OrdinalIgnoreCase)
            ? "Giant Lampoon"
            : $"{pageTitle} - Giant Lampoon";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <meta
        name="description"
        content="Giant Lampoon — literature and stuff, fiction and satire, and other writing." />

    <title>@documentTitle</title>

    <!-- Bootstrap CSS stored in wwwroot/lib -->
    <link
        rel="stylesheet"
        href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Your custom CSS stored in wwwroot/css -->
    <link
        rel="stylesheet"
        href="~/css/site.css"
        asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
            <div class="container">
                <a
                    class="navbar-brand"
                    asp-controller="Home"
                    asp-action="Index">
                    GIANT LAMPOON
                </a>

                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div
                    class="collapse navbar-collapse"
                    id="mainNavigation">

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a
                                class="nav-link"
                                asp-controller="Home"
                                asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link"
                                asp-controller="BookClubs"
                                asp-action="Index">
                                Book Clubs
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Posts" asp-action="Index">@(User.IsInRole(RoleNames.Admin) ? "All Posts" : "My Posts")</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Posts" asp-action="Create">Create Post</a></li>
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>
                &copy; @DateTime.Now.Year Giant Lampoon.
                All rights reserved.
            </p>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your custom JavaScript -->
    <script
        src="~/js/site.js"
        asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>