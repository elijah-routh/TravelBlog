@using TravelBlog.Web.Authorization
@using Microsoft.AspNetCore.Identity
@using TravelBlog.Web.Models
@using TravelBlog.Web.Services
@inject UserManager<ApplicationUser> UserManager
@{
    var pageTitle = ViewData["Title"] as string;
    var documentTitle =
        string.IsNullOrWhiteSpace(pageTitle) ||
        string.Equals(pageTitle, "Home", StringComparison.OrdinalIgnoreCase)
            ? "Giant Lampoon"
            : $"{pageTitle} - Giant Lampoon";
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var hasVerifiedEmail = currentUser?.EmailConfirmed == true;
    var verificationFingerprint = currentUser is not null &&
        !hasVerifiedEmail
            ? VerificationNoticeFingerprint.Create(currentUser)
            : null;
    var pageBackgroundClass =
        PageBackgrounds.GetBodyClass(ViewData[PageBackgrounds.ViewDataKey]);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <meta
        name="description"
        content="Giant Lampoon — literature and stuff, fiction and satire, and other writing." />

    <title>@documentTitle</title>

    <!-- Bootstrap CSS stored in wwwroot/lib -->
    <link
        rel="stylesheet"
        href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Your custom CSS stored in wwwroot/css -->
    <link
        rel="stylesheet"
        href="~/css/site.css"
        asp-append-version="true" />

    @if (pageBackgroundClass is not null)
    {
        <link
            rel="stylesheet"
            href="~/css/page-backgrounds.css"
            asp-append-version="true" />
    }
</head>

<body class="@pageBackgroundClass">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
            <div class="container">
                <a
                    class="navbar-brand"
                    asp-controller="Home"
                    asp-action="Index">
                    GIANT LAMPOON
                </a>

                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div
                    class="collapse navbar-collapse"
                    id="mainNavigation">

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a
                                class="nav-link"
                                asp-controller="Home"
                                asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link"
                                asp-controller="BookClubs"
                                asp-action="Index">
                                Book Clubs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                class="nav-link"
                                asp-controller="Posts"
                                asp-action="Index">
                                Posts
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (hasVerifiedEmail)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Posts" asp-action="Create">Create</a></li>
                            }
                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (verificationFingerprint is not null)
    {
        <div
            class="toast-container position-fixed top-0 end-0 p-3 verification-toast-container">
            <div
                id="verification-email-toast"
                class="toast verification-email-toast"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                data-verification-toast
                data-verification-fingerprint="@verificationFingerprint">
                <div class="toast-header">
                    <strong class="me-auto">Verify your email</strong>
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Dismiss verification reminder">
                    </button>
                </div>
                <div class="toast-body">
                    Verify your email before creating or changing content.
                    <a asp-area="Identity" asp-page="/Account/Manage/Email">
                        Review email verification
                    </a>.
                </div>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>
                &copy; @DateTime.Now.Year Giant Lampoon.
                All rights reserved.
            </p>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your custom JavaScript -->
    <script
        src="~/js/site.js"
        asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>