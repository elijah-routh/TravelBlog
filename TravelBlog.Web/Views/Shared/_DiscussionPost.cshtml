@model DiscussionPostItemViewModel

<p class="fw-semibold mb-1">
    @Model.AuthorDisplayName
    @if (Model.IsPinned)
    {
        <span class="discussion-pinned-label">Pinned</span>
    }
</p>
@if (Model.Poll is null)
{
    <p class="club-discussion-body mb-1">@Model.Body</p>
}
else
{
    <h3 class="h5 mb-3">@Model.Body</h3>
    <partial name="_DiscussionPoll" model="Model.Poll" />
}
<p class="small text-muted mb-2">
    @Model.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
    @if (Model.UpdatedAt is not null)
    {
        <text>· edited</text>
    }
</p>

@if (Model.CanEdit || Model.CanDelete || Model.CanReply || Model.CanPin)
{
    <div class="comment-actions mb-2">
        @if (Model.CanEdit)
        {
            <a
                asp-controller="DiscussionPosts"
                asp-action="Edit"
                asp-route-slug="@Model.ClubSlug"
                asp-route-id="@Model.Id"
                class="icon-action"
                title="Edit message"
                aria-label="Edit message">
                &#9998;
            </a>
        }
        @if (Model.CanDelete)
        {
            <a
                asp-controller="DiscussionPosts"
                asp-action="Delete"
                asp-route-slug="@Model.ClubSlug"
                asp-route-id="@Model.Id"
                class="icon-action icon-action-danger"
                title="Delete message"
                aria-label="Delete message">
                &#128465;
            </a>
        }
        @if (Model.CanPin)
        {
            <form
                asp-controller="DiscussionPosts"
                asp-action="TogglePin"
                asp-route-slug="@Model.ClubSlug"
                asp-route-id="@Model.Id"
                asp-route-sort="@(Context.Request.Query["sort"].ToString())"
                method="post">
                <button
                    type="submit"
                    class="icon-action @(Model.IsPinned ? "discussion-pin-active" : null)"
                    title="@(Model.IsPinned ? "Unpin message" : "Pin message")"
                    aria-label="@(Model.IsPinned ? "Unpin message" : "Pin message")">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true">
                        <path d="M12 17v5" />
                        <path d="M5 17h14" />
                        <path d="M6 3h12l-2 7 3 3H5l3-3-2-7z" />
                    </svg>
                </button>
            </form>
        }
        @if (Model.CanReply)
        {
            <button
                type="button"
                class="reply-toggle"
                data-bs-toggle="collapse"
                data-bs-target="#discussion-reply-@Model.Id"
                aria-expanded="false"
                aria-controls="discussion-reply-@Model.Id">
                Reply
            </button>
        }
    </div>
}

@if (Model.CanReply)
{
    <div class="collapse" id="discussion-reply-@Model.Id">
        <form
            asp-controller="DiscussionPosts"
            asp-action="Reply"
            asp-route-slug="@Model.ClubSlug"
            asp-route-id="@Model.Id"
            asp-route-sort="@(Context.Request.Query["sort"].ToString())"
            method="post"
            class="compact-reply-form mb-3">
            <label class="form-label visually-hidden" for="reply-@Model.Id">
                Reply
            </label>
            <textarea
                name="Body"
                id="reply-@Model.Id"
                class="form-control form-control-sm mb-2"
                rows="2"
                maxlength="2000"
                placeholder="Write a reply."
                required></textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary">
                Post Reply
            </button>
        </form>
    </div>
}

@if (Model.Replies.Count > 0)
{
    <button
        type="button"
        class="reply-toggle"
        data-bs-toggle="collapse"
        data-bs-target="#discussion-thread-@Model.Id"
        aria-expanded="false"
        aria-controls="discussion-thread-@Model.Id">
        @Model.Replies.Count @(Model.Replies.Count == 1 ? "reply" : "replies")
    </button>
    <div class="collapse" id="discussion-thread-@Model.Id">
        <ul class="list-unstyled club-discussion-replies">
            @foreach (var reply in Model.Replies)
            {
                <li class="club-discussion-post club-discussion-reply">
                    <partial name="_DiscussionPost" model="reply" />
                </li>
            }
        </ul>
    </div>
}
