@using Microsoft.AspNetCore.Identity
@using TravelBlog.Web.Authorization
@model IEnumerable<TravelBlog.Web.Models.Post>
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Posts";
    var currentUser = await UserManager.GetUserAsync(User);
    var canWrite = currentUser?.EmailConfirmed == true;
}

<section class="content-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h1 class="mb-1">Posts</h1>

                <p class="text-muted mb-0">
                    Manage Giant Lampoon posts — create, edit, and publish.
                </p>
            </div>

            @if (canWrite)
            {
                <a
                    asp-controller="Posts"
                    asp-action="Create"
                    class="btn btn-primary">
                    Create New Post
                </a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No posts have been created yet.

                @if (canWrite)
                {
                    <a
                        asp-controller="Posts"
                        asp-action="Create"
                        class="alert-link">
                        Create your first post.
                    </a>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var post in Model)
                {
                    <div class="col-sm-12 col-md-6 col-lg-4">
                        <article class="card travel-card">
                            @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                            {
                                <img
                                    src="@Url.Content(post.ImagePath)"
                                    class="card-img-top"
                                    alt="@post.Title" />
                            }

                            <div class="card-body d-flex flex-column">
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <span class="badge text-bg-primary">
                                        @Html.DisplayFor(
                                            _ => post.Category
                                        )
                                    </span>

                                    @if (post.IsPublished)
                                    {
                                        <span class="badge text-bg-success">
                                            Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Draft
                                        </span>
                                    }
                                </div>

                                <h2 class="card-title h4">
                                    @post.Title
                                </h2>
                                <p class="small text-muted mb-2">
                                    By @post.Author.DisplayName
                                </p>

                                @if (!string.IsNullOrWhiteSpace(post.Summary))
                                {
                                    <p class="card-text">
                                        @post.Summary
                                    </p>
                                }

                                <p class="small text-muted">
                                    Created
                                    @post.CreatedAt
                                        .ToLocalTime()
                                        .ToString("MMMM d, yyyy")
                                </p>

                                <div class="mt-auto d-flex flex-wrap gap-2">
                                    <a
                                        asp-action="Details"
                                        asp-route-slug="@post.Slug"
                                        class="btn btn-outline-primary">
                                        View
                                    </a>

                                    @if (canWrite &&
                                        (User.IsInRole(RoleNames.Admin) ||
                                         post.AuthorId == UserManager.GetUserId(User)))
                                    {
                                        <a
                                            asp-action="Edit"
                                            asp-route-id="@post.Id"
                                            class="icon-action"
                                            title="Edit post"
                                            aria-label="Edit @post.Title">&#9998;</a>
                                        <a
                                            asp-action="Delete"
                                            asp-route-id="@post.Id"
                                            class="icon-action icon-action-danger"
                                            title="Delete post"
                                            aria-label="Delete @post.Title">&#128465;</a>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>