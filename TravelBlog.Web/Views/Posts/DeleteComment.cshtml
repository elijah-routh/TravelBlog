@model PostComment

@{
    ViewData["Title"] = "Delete Comment";
}

<section class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-7">
                <div class="card border-danger">
                    <div class="card-body">
                        <h1 class="card-title h2 text-danger">
                            Delete Comment
                        </h1>

                        <p>Are you sure you want to delete this comment?</p>

                        <p class="club-discussion-body">@Model.Body</p>
                        <p class="small text-muted">
                            @Model.Author.DisplayName ·
                            @Model.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
                        </p>

                        <form
                            asp-controller="Posts"
                            asp-action="DeleteComment"
                            asp-route-id="@Model.Id"
                            method="post">
                            <button type="submit" class="btn btn-danger">
                                Delete Permanently
                            </button>
                            <a
                                asp-controller="Posts"
                                asp-action="Details"
                                asp-route-slug="@Model.Post.Slug"
                                class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
