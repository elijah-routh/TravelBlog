@using Microsoft.AspNetCore.Identity
@using TravelBlog.Web.Authorization
@model TravelBlog.Web.Models.Post
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Title;
}

<article class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-9">

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge text-bg-primary">
                        @Html.DisplayFor(model => model.Category)
                    </span>

                    @if (Model.IsPublished)
                    {
                        <span class="badge text-bg-success">
                            Published
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">
                            Draft
                        </span>
                    }
                </div>

                <h1 class="display-4 fw-bold">
                    @Model.Title
                </h1>

                <p class="text-muted">
                    By @Model.Author.DisplayName ·
                    @Model.CreatedAt
                        .ToLocalTime()
                        .ToString("MMMM d, yyyy")
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <img
                        src="@Url.Content(Model.ImagePath)"
                        class="img-fluid rounded w-100 mb-4 post-detail-image"
                        alt="@Model.Title" />
                }

                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <p class="lead">
                        @Model.Summary
                    </p>
                }

                <div class="post-content">
                    @Model.Content
                </div>

                <hr class="my-5" />

                <div class="d-flex flex-wrap gap-2">
                    <a
                        asp-controller="Posts"
                        asp-action="Index"
                        class="btn btn-outline-secondary">
                        Back to Posts
                    </a>

                    @if (User.Identity?.IsAuthenticated == true &&
                        (User.IsInRole(RoleNames.Admin) ||
                         Model.AuthorId == UserManager.GetUserId(User)))
                    {
                        <a asp-controller="Posts" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
                        <a asp-controller="Posts" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
                    }
                </div>
            </div>
        </div>
    </div>
</article>