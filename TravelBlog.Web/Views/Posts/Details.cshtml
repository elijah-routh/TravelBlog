@using Microsoft.AspNetCore.Identity
@using TravelBlog.Web.Authorization
@model PostDetailsViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Post.Title;
    var postImagePath = SiteBranding.PostCardImage(
        Model.Post.ImagePath,
        Model.Post.Id,
        Url,
        NutPlaceholders);
    var isPlaceholderImage =
        SiteBranding.IsPlaceholderImage(Model.Post.ImagePath);
}

<article class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-9">

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-primary">
                        @Html.DisplayFor(model => model.Post.Category)
                    </span>

                    @if (Model.IsContactMessage)
                    {
                        <span class="badge bg-info text-dark">
                            Contact message
                        </span>
                    }
                    else if (Model.Post.IsHidden)
                    {
                        <span class="badge bg-warning text-dark">
                            Hidden
                        </span>
                    }
                    else if (Model.Post.IsPublished)
                    {
                        <span class="badge bg-success">
                            Published
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Draft
                        </span>
                    }
                </div>

                <h1 class="display-4 fw-bold">
                    @Model.Post.Title
                </h1>

                <p class="text-muted mb-2">
                    By @Model.Post.Author.DisplayName ·
                    @Model.Post.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
                </p>

                <div class="post-engagement mb-4">
                    @if (!Model.IsContactMessage)
                    {
                        var postLikeButton = new LikeButtonViewModel
                        {
                            Count = Model.LikeCount,
                            IsLiked = Model.IsLikedByCurrentUser,
                            CanLike = Model.CanLike,
                            Controller = "Posts",
                            Action = "ToggleLike",
                            RouteValues = new Dictionary<string, string>
                            {
                                ["slug"] = Model.Post.Slug
                            }
                        };
                        <partial name="_LikeButton" model="postLikeButton" />
                    }
                    <span class="post-view-count">
                        @Model.ViewCount @(Model.ViewCount == 1 ? "view" : "views")
                    </span>
                </div>

                <img
                    src="@postImagePath"
                    class="img-fluid rounded w-100 mb-4 post-detail-image@(isPlaceholderImage ? " post-card-image--placeholder" : null)"
                    alt="@Model.Post.Title" />

                @if (!string.IsNullOrWhiteSpace(Model.Post.Summary))
                {
                    <p class="lead">
                        @Model.Post.Summary
                    </p>
                }

                <div class="post-content">
                    @Model.Post.Content
                </div>

                <hr class="my-5" />

                <div class="d-flex flex-wrap gap-2 mb-5">
                    @if (Model.IsContactMessage)
                    {
                        <a
                            asp-controller="Users"
                            asp-action="Contact"
                            class="btn btn-outline-secondary">
                            Back to Contact
                        </a>
                    }
                    else
                    {
                        <a
                            asp-controller="Posts"
                            asp-action="Index"
                            class="btn btn-outline-secondary">
                            Back to Posts
                        </a>
                    }

                    @if (Model.CanModeratePost)
                    {
                        if (Model.Post.IsHidden)
                        {
                            <form
                                asp-controller="Posts"
                                asp-action="Unhide"
                                asp-route-id="@Model.Post.Id"
                                method="post"
                                class="d-inline">
                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-warning">
                                    Unhide
                                </button>
                            </form>
                        }
                        else
                        {
                            <form
                                asp-controller="Posts"
                                asp-action="Hide"
                                asp-route-id="@Model.Post.Id"
                                method="post"
                                class="d-inline">
                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-warning">
                                    Hide
                                </button>
                            </form>
                        }
                    }

                    @if (Model.CanManagePost)
                    {
                        if (!Model.IsContactMessage)
                        {
                            <a
                                asp-controller="Posts"
                                asp-action="Edit"
                                asp-route-id="@Model.Post.Id"
                                class="icon-action"
                                title="Edit post"
                                aria-label="Edit post">&#9998;</a>
                        }

                        <a
                            asp-controller="Posts"
                            asp-action="Delete"
                            asp-route-id="@Model.Post.Id"
                            class="icon-action icon-action-danger"
                            title="Delete post"
                            aria-label="Delete post">&#128465;</a>
                    }
                </div>

                @if (!Model.IsContactMessage)
                {
                <section class="club-panel">
                    <h2 class="h4 mb-3">Comments</h2>

                    @if (TempData["StatusMessage"] is string status)
                    {
                        <div class="alert alert-success">@status</div>
                    }
                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    @if (Model.Comments.Count == 0)
                    {
                        <p class="text-muted">No comments yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled club-discussion-list">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="club-discussion-post">
                                    <partial name="_PostComment" model="comment" />
                                </li>
                            }
                        </ul>
                    }

                    @if (Model.CanComment)
                    {
                        <form
                            asp-controller="Posts"
                            asp-action="AddComment"
                            asp-route-slug="@Model.Post.Slug"
                            method="post">
                            <div class="mb-2">
                                <label asp-for="NewComment.Body" class="form-label"></label>
                                <textarea
                                    asp-for="NewComment.Body"
                                    class="form-control"
                                    rows="4"
                                    placeholder="Share a comment.">
                                </textarea>
                                <span asp-validation-for="NewComment.Body" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                Post Comment
                            </button>
                        </form>
                    }
                    else if (Model.IsAuthenticated)
                    {
                        @if (Model.IsCurrentUserBlocked)
                        {
                            <div class="alert alert-danger mb-0" role="status">
                                Your account is blocked and cannot comment on posts.
                            </div>
                        }
                        else
                        {
                        <div class="alert alert-warning mb-0" role="status">
                            Verify your email before commenting on this post.
                            <a
                                asp-area="Identity"
                                asp-page="/Account/Manage/Email"
                                class="alert-link">
                                Review email verification
                            </a>.
                        </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            <a
                                asp-area="Identity"
                                asp-page="/Account/Login"
                                asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
                                Log in
                            </a>
                            to comment on this post.
                        </p>
                    }
                </section>
                }
            </div>
        </div>
    </div>
</article>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
