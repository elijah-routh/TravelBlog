@using Microsoft.AspNetCore.Identity
@using TravelBlog.Web.Authorization
@model PostDetailsViewModel
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Post.Title;
}

<article class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-9">

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge text-bg-primary">
                        @Html.DisplayFor(model => model.Post.Category)
                    </span>

                    @if (Model.Post.IsPublished)
                    {
                        <span class="badge text-bg-success">
                            Published
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">
                            Draft
                        </span>
                    }
                </div>

                <h1 class="display-4 fw-bold">
                    @Model.Post.Title
                </h1>

                <p class="text-muted">
                    By @Model.Post.Author.DisplayName ·
                    @Model.Post.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Post.ImagePath))
                {
                    <img
                        src="@Url.Content(Model.Post.ImagePath)"
                        class="img-fluid rounded w-100 mb-4 post-detail-image"
                        alt="@Model.Post.Title" />
                }

                @if (!string.IsNullOrWhiteSpace(Model.Post.Summary))
                {
                    <p class="lead">
                        @Model.Post.Summary
                    </p>
                }

                <div class="post-content">
                    @Model.Post.Content
                </div>

                <hr class="my-5" />

                <div class="d-flex flex-wrap gap-2 mb-5">
                    <a
                        asp-controller="Posts"
                        asp-action="Index"
                        class="btn btn-outline-secondary">
                        Back to Posts
                    </a>

                    @if (Model.CanManagePost)
                    {
                        <a
                            asp-controller="Posts"
                            asp-action="Edit"
                            asp-route-id="@Model.Post.Id"
                            class="icon-action"
                            title="Edit post"
                            aria-label="Edit post">&#9998;</a>
                        <a
                            asp-controller="Posts"
                            asp-action="Delete"
                            asp-route-id="@Model.Post.Id"
                            class="icon-action icon-action-danger"
                            title="Delete post"
                            aria-label="Delete post">&#128465;</a>
                    }
                </div>

                <section class="club-panel">
                    <h2 class="h4 mb-3">Comments</h2>

                    @if (TempData["StatusMessage"] is string status)
                    {
                        <div class="alert alert-success">@status</div>
                    }
                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    @if (Model.Comments.Count == 0)
                    {
                        <p class="text-muted">No comments yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled club-discussion-list">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="club-discussion-post">
                                    <partial name="_PostComment" model="comment" />
                                </li>
                            }
                        </ul>
                    }

                    @if (Model.CanComment)
                    {
                        <form
                            asp-controller="Posts"
                            asp-action="AddComment"
                            asp-route-slug="@Model.Post.Slug"
                            method="post">
                            <div class="mb-2">
                                <label asp-for="NewComment.Body" class="form-label"></label>
                                <textarea
                                    asp-for="NewComment.Body"
                                    class="form-control"
                                    rows="4"
                                    placeholder="Share a comment.">
                                </textarea>
                                <span asp-validation-for="NewComment.Body" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                Post Comment
                            </button>
                        </form>
                    }
                    else if (Model.IsAuthenticated)
                    {
                        <div class="alert alert-warning mb-0" role="status">
                            Verify your email before commenting on this post.
                            <a
                                asp-area="Identity"
                                asp-page="/Account/Manage/Email"
                                class="alert-link">
                                Review email verification
                            </a>.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            <a
                                asp-area="Identity"
                                asp-page="/Account/Login"
                                asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
                                Log in
                            </a>
                            to comment on this post.
                        </p>
                    }
                </section>
            </div>
        </div>
    </div>
</article>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
