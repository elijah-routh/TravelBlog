@model TravelBlog.Web.Models.Post

@{
    ViewData["Title"] = "Create Post";
}

<section class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-8">
                <h1 class="mb-4">Create a New Post</h1>

                <form
                    asp-controller="Posts"
                    asp-action="Create"
                    method="post">

                    <div
                        asp-validation-summary="ModelOnly"
                        class="alert alert-danger">
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Title"
                            class="form-label">
                        </label>

                        <input
                            asp-for="Title"
                            class="form-control"
                            placeholder="Colca Canyon Travel Guide" />

                        <span
                            asp-validation-for="Title"
                            class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Slug"
                            class="form-label">
                            URL Slug
                        </label>

                        <input
                            asp-for="Slug"
                            class="form-control"
                            placeholder="colca-canyon-travel-guide" />

                        <div class="form-text">
                            Use lowercase letters, numbers, and hyphens.
                        </div>

                        <span
                            asp-validation-for="Slug"
                            class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Summary"
                            class="form-label">
                        </label>

                        <textarea
                            asp-for="Summary"
                            class="form-control"
                            rows="3"
                            placeholder="A short introduction shown on the post card.">
                        </textarea>

                        <span
                            asp-validation-for="Summary"
                            class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Content"
                            class="form-label">
                        </label>

                        <textarea
                            asp-for="Content"
                            class="form-control"
                            rows="14"
                            placeholder="Write the complete blog post here.">
                        </textarea>

                        <span
                            asp-validation-for="Content"
                            class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="ImagePath"
                            class="form-label">
                        </label>

                        <input
                            asp-for="ImagePath"
                            class="form-control"
                            placeholder="/images/CountryPictures/ColcaCanyonIcon.jpg" />

                        <div class="form-text">
                            For now, enter the path to an image already
                            stored in wwwroot.
                        </div>

                        <span
                            asp-validation-for="ImagePath"
                            class="text-danger">
                        </span>
                    </div>

                    <div class="form-check mb-4">
                        <input
                            asp-for="IsPublished"
                            class="form-check-input" />

                        <label
                            asp-for="IsPublished"
                            class="form-check-label">
                            Publish this post
                        </label>
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary">
                        Save Post
                    </button>

                    <a
                        asp-controller="Posts"
                        asp-action="Index"
                        class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}