@model ClubBookDeleteViewModel

@{
    ViewData["Title"] = "Delete Book";
}

<section class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-7">
                <div class="card border-danger">
                    <div class="card-body">
                        <h1 class="card-title h2 text-danger">
                            Delete Book
                        </h1>

                        <p>
                            Are you sure you want to remove this book from
                            @Model.ClubName? Its discussion thread will also
                            be deleted.
                        </p>

                        <h2 class="h4">@Model.Title</h2>
                        <p class="text-muted">@Model.AuthorName</p>

                        <form
                            asp-controller="ClubBooks"
                            asp-action="Delete"
                            asp-route-clubSlug="@Model.ClubSlug"
                            asp-route-bookId="@Model.Id"
                            method="post">
                            <button type="submit" class="btn btn-danger">
                                Delete Permanently
                            </button>
                            <a
                                asp-controller="ClubBooks"
                                asp-action="Details"
                                asp-route-clubSlug="@Model.ClubSlug"
                                asp-route-bookId="@Model.Id"
                                class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
