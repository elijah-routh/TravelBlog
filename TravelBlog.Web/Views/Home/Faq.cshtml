@model FaqViewModel

@{
    ViewData["Title"] = "FAQs";
}

<section class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="mb-4">FAQs</h1>

                <div class="faq-page">
                    @foreach (var item in Model.Items)
                    {
                        <article class="faq-entry">
                            <h2 class="faq-entry__question">
                                @item.Question
                            </h2>
                            <p class="faq-entry__answer">
                                @item.Answer
                            </p>
                        </article>
                    }
                </div>

                <p class="faq-contact-note mt-4 mb-0">
                    Still have a question?
                    <a asp-action="Contact">Send us a message</a>.
                </p>
            </div>
        </div>
    </div>
</section>
