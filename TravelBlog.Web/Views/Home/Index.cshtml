@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document
                .querySelectorAll("[data-scroll-left]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const row = document.getElementById(
                            button.dataset.scrollLeft
                        );

                        row?.scrollBy({
                            left: -320,
                            behavior: "smooth"
                        });
                    });
                });

            document
                .querySelectorAll("[data-scroll-right]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const row = document.getElementById(
                            button.dataset.scrollRight
                        );

                        row?.scrollBy({
                            left: 320,
                            behavior: "smooth"
                        });
                    });
                });

            const hero = document.querySelector(".hero");
            const motionToggle = document.querySelector(
                ".hero-motion-toggle"
            );

            motionToggle?.addEventListener("click", function () {
                const isStatic = hero?.classList.toggle("hero-static");
                const icon = motionToggle.querySelector(
                    ".hero-motion-toggle-icon"
                );
                const label = motionToggle.querySelector(
                    ".hero-motion-toggle-label"
                );

                motionToggle.setAttribute(
                    "aria-pressed",
                    String(Boolean(isStatic))
                );
                motionToggle.title = isStatic
                    ? "Play banner animation"
                    : "Pause banner animation";

                if (icon) {
                    icon.textContent = isStatic ? "▶" : "⏸";
                }

                if (label) {
                    label.textContent = isStatic
                        ? "Play banner"
                        : "Pause banner";
                }
            });
        });
    </script>
}