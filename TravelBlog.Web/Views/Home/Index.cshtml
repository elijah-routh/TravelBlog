@model TravelBlog.Web.Models.HomeIndexViewModel
@using TravelBlog.Web.Services

@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<header class="hero">
    <div class="hero-marquee" aria-hidden="true">
        <div class="hero-marquee-track">
            @for (var i = 0; i < 4; i++)
            {
                <img
                    src="~/images/GiantLampoonBannerFinal.jpg"
                    alt="" />
            }
        </div>

        <img
            src="~/images/GiantLampoonBanner.png"
            class="hero-static-image"
            alt="" />
    </div>

    <div class="hero-content">
        <p class="text-uppercase mb-2">
            Books, fiction, and satire
        </p>

        <h1>Giant Lampoon</h1>

        <p>
            An independent publication for creative stuff,
            super functional book clubs, and a lil something different.
        </p>

        <a
            href="#literature-and-stuff"
            class="btn btn-primary btn-lg">
            Read the Latest
        </a>
    </div>

    <button
        type="button"
        class="hero-motion-toggle"
        aria-pressed="false"
        title="Pause banner animation">
        <span class="hero-motion-toggle-icon" aria-hidden="true">⏸</span>
        <span class="hero-motion-toggle-label">Pause banner</span>
    </button>
</header>

<!-- Category rows -->
@foreach (var category in Model.Categories)
{
    <section
        id="@category.Slug"
        class="content-section editorial-row-section">

        <div class="container">
            <div class="editorial-row-heading">
                <h2 class="section-title mb-0">
                    @category.Name
                </h2>

                @if (category.Posts.Count > 0)
                {
                    <div class="editorial-row-controls">
                        <button
                            type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-scroll-left="@category.Slug-row"
                            aria-label="Scroll @category.Name left">
                            ←
                        </button>

                        <button
                            type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-scroll-right="@category.Slug-row"
                            aria-label="Scroll @category.Name right">
                            →
                        </button>
                    </div>
                }
            </div>

            @if (category.Posts.Count > 0)
            {
                <div
                    id="@category.Slug-row"
                    class="editorial-card-row">

                    @foreach (var post in category.Posts)
                    {
                        var imagePath = SiteBranding.PostCardImage(
                            post.ImagePath,
                            post.Id,
                            Url,
                            NutPlaceholders);
                        var isPlaceholderImage =
                            SiteBranding.IsPlaceholderImage(post.ImagePath);

                        <article class="card travel-card editorial-row-card">
                            <img
                                src="@imagePath"
                                class="card-img-top@(isPlaceholderImage ? " post-card-image--placeholder" : null)"
                                alt="@post.Title" />

                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title editorial-row-card__title">
                                    @post.Title
                                </h3>
                                <p class="editorial-row-card__author small text-muted">
                                    By @post.Author.DisplayName
                                </p>

                                <p class="card-text editorial-row-card__summary">
                                    @{
                                        var summaryText =
                                            string.IsNullOrWhiteSpace(post.Summary)
                                                ? "Read the full post to learn more."
                                                : post.Summary;
                                    }
                                    @TextPreview.Truncate(
                                        summaryText,
                                        EditorialCardSummaryLimits.ForTitle(post.Title))
                                </p>

                                <div class="editorial-row-card__footer">
                                    <a
                                        asp-controller="Posts"
                                        asp-action="Details"
                                        asp-route-slug="@post.Slug"
                                        class="btn btn-outline-primary editorial-row-card__cta">
                                        Read Post
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No published posts are available in this category yet.
                </p>
            }
        </div>
    </section>
}

<!-- About -->
<section
    id="about"
    class="content-section about-section">

    <div class="container">
        <div class="row align-items-center justify-content-center g-4">

            <div class="col-sm-12 col-md-4 text-center">
                <img
                    src="~/images/CountryPictures/Baja-Road.jpg"
                    class="author-photo"
                    alt="Giant Lampoon" />
            </div>

            <div class="col-sm-12 col-md-7">
                <h2>About Giant Lampoon</h2>

                <p>
                    Giant Lampoon is about things. Things that make you laugh and things. Things about stories. Other things. Many things.
                </p>

                <p>
                    Join the totally cool book club!
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a
                        asp-controller="Posts"
                        asp-action="Index"
                        class="btn btn-dark">
                        Browse
                    </a>
                    <a
                        asp-controller="BookClubs"
                        asp-action="Index"
                        class="btn btn-dark">
                        Clubs
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

