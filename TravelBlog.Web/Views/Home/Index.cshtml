@model TravelBlog.Web.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- Hero -->
<header class="hero">
    <div class="hero-content">
        <p class="text-uppercase mb-2">
            Satire, fiction, and reporting
        </p>

        <h1>Giant Lampoon</h1>

        <p>
            An independent publication for parody editorials,
            original short stories, and real news.
        </p>

        <a
            href="#parody-editorial"
            class="btn btn-primary btn-lg">
            Read the Latest
        </a>
    </div>
</header>

<!-- Category rows -->
@foreach (var category in Model.Categories)
{
    <section
        id="@category.Slug"
        class="content-section editorial-row-section">

        <div class="container">
            <div class="editorial-row-heading">
                <h2 class="section-title mb-0">
                    @category.Name
                </h2>

                @if (category.Posts.Count > 0)
                {
                    <div class="editorial-row-controls">
                        <button
                            type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-scroll-left="@category.Slug-row"
                            aria-label="Scroll @category.Name left">
                            ←
                        </button>

                        <button
                            type="button"
                            class="btn btn-outline-primary btn-sm"
                            data-scroll-right="@category.Slug-row"
                            aria-label="Scroll @category.Name right">
                            →
                        </button>
                    </div>
                }
            </div>

            @if (category.Posts.Count > 0)
            {
                <div
                    id="@category.Slug-row"
                    class="editorial-card-row">

                    @foreach (var post in category.Posts)
                    {
                        var imagePath =
                            string.IsNullOrWhiteSpace(post.ImagePath)
                                ? Url.Content(
                                    "~/images/CountryPictures/ColcaCanyonIcon.jpg"
                                )
                                : Url.Content(post.ImagePath);

                        <article class="card travel-card editorial-row-card">
                            <img
                                src="@imagePath"
                                class="card-img-top"
                                alt="@post.Title" />

                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title">
                                    @post.Title
                                </h3>

                                <p class="card-text">
                                    @(
                                        string.IsNullOrWhiteSpace(post.Summary)
                                            ? "Read the full post to learn more."
                                            : post.Summary
                                    )
                                </p>

                                <a
                                    asp-controller="Posts"
                                    asp-action="Details"
                                    asp-route-slug="@post.Slug"
                                    class="btn btn-outline-primary mt-auto">
                                    Read Post
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No published posts are available in this category yet.
                </p>
            }
        </div>
    </section>
}

<!-- About -->
<section
    id="about"
    class="content-section about-section">

    <div class="container">
        <div class="row align-items-center justify-content-center g-4">

            <div class="col-sm-12 col-md-4 text-center">
                <img
                    src="~/images/CountryPictures/ColcaCanyonIcon.jpg"
                    class="author-photo"
                    alt="Giant Lampoon" />
            </div>

            <div class="col-sm-12 col-md-7">
                <h2>About Giant Lampoon</h2>

                <p>
                    Giant Lampoon collects parody editorials,
                    original short fiction, and real reporting.
                </p>

                <p>
                    Each section offers a different kind of story,
                    from satire to fiction to current events.
                </p>

                <a
                    href="#parody-editorial"
                    class="btn btn-dark">
                    Browse the Archive
                </a>
            </div>

        </div>
    </div>
</section>

<!-- Newsletter -->
<section class="content-section">
    <div class="container">
        <div class="newsletter text-center">
            <div class="row justify-content-center">
                <div class="col-sm-12 col-lg-8">
                    <h2>Follow Giant Lampoon</h2>

                    <p>
                        Get new editorials, stories, and news posts
                        from Giant Lampoon as they are published.
                    </p>

                    <form
                        class="row g-2 justify-content-center"
                        onsubmit="return false;">

                        <div class="col-sm-12 col-md-7">
                            <label
                                for="emailAddress"
                                class="visually-hidden">
                                Email address
                            </label>

                            <input
                                type="email"
                                class="form-control form-control-lg"
                                id="emailAddress"
                                placeholder="Enter your email" />
                        </div>

                        <div class="col-sm-12 col-md-auto">
                            <button
                                type="submit"
                                class="btn btn-primary btn-lg w-100">
                                Subscribe
                            </button>
                        </div>
                    </form>

                    <p class="small mt-3 mb-0">
                        Newsletter signup will be connected later.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document
                .querySelectorAll("[data-scroll-left]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const row = document.getElementById(
                            button.dataset.scrollLeft
                        );

                        row?.scrollBy({
                            left: -320,
                            behavior: "smooth"
                        });
                    });
                });

            document
                .querySelectorAll("[data-scroll-right]")
                .forEach(function (button) {
                    button.addEventListener("click", function () {
                        const row = document.getElementById(
                            button.dataset.scrollRight
                        );

                        row?.scrollBy({
                            left: 320,
                            behavior: "smooth"
                        });
                    });
                });
        });
    </script>
}