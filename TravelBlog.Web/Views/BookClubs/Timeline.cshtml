@model CombinedBookTimelineViewModel

@{
    ViewData["Title"] = "Book Club Timeline";
}

<section class="content-section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <p class="text-uppercase small text-muted mb-1">All clubs</p>
                <h1 class="mb-2">Combined Reading Timeline</h1>
                <p class="text-muted mb-0">
                    Every book from every club, ordered by reading date.
                </p>
            </div>
            <a
                asp-controller="BookClubs"
                asp-action="Index"
                class="btn btn-outline-secondary">
                Back to Book Clubs
            </a>
        </div>

        @if (Model.Books.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No books have been added to a club yet.
            </div>
        }
        else
        {
            <div class="club-panel">
                <ol class="club-timeline">
                    @foreach (var book in Model.Books)
                    {
                        <li class="club-timeline-item">
                            <div class="book-timeline-content">
                                @if (!string.IsNullOrWhiteSpace(book.ImagePath))
                                {
                                    <img
                                        src="@book.ImagePath"
                                        class="book-timeline-cover"
                                        alt="Cover of @book.Title" />
                                }
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="badge timeline-status-badge @(book.Status == ClubBookTimeline.Current ? "timeline-status-current" : book.Status == ClubBookTimeline.Upcoming ? "timeline-status-upcoming" : "timeline-status-past")">
                                            @book.Status
                                        </span>
                                        <time class="small text-muted">
                                            @book.StartDate.ToString("MMM d, yyyy")
                                            –
                                            @book.EndDate.ToString("MMM d, yyyy")
                                        </time>
                                        <a
                                            asp-controller="BookClubs"
                                            asp-action="Details"
                                            asp-route-slug="@book.ClubSlug"
                                            class="small text-muted text-decoration-none timeline-club-link">
                                            @book.ClubName
                                        </a>
                                    </div>
                                    <h2 class="h5 mb-1">
                                        <a
                                            asp-controller="ClubBooks"
                                            asp-action="Details"
                                            asp-route-clubSlug="@book.ClubSlug"
                                            asp-route-bookId="@book.Id">
                                            @book.Title
                                        </a>
                                    </h2>
                                    <p class="mb-1">@book.AuthorName</p>
                                    @if (!string.IsNullOrWhiteSpace(book.Notes))
                                    {
                                        <p class="small text-muted mb-0">@book.Notes</p>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
</section>
