@model BookClubFormViewModel

@{
    ViewData["Title"] = "Edit Book Club";
}

<section class="content-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-12 col-lg-8">
                <h1 class="mb-4">Edit Book Club</h1>

                <form
                    asp-controller="BookClubs"
                    asp-action="Edit"
                    asp-route-slug="@(ViewData["ClubSlug"] ?? Model.Slug)"
                    method="post">

                    <div
                        asp-validation-summary="ModelOnly"
                        class="alert alert-danger">
                    </div>

                    <partial name="_BookClubFormFields" />

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a
                        asp-controller="BookClubs"
                        asp-action="Details"
                        asp-route-slug="@(ViewData["ClubSlug"] ?? Model.Slug)"
                        class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
